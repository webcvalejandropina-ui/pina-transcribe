# Copia este archivo como pina.env y ajusta lo que necesites.
# Copy this file to pina.env and adjust what you need.
# No subas pina.env a ningún repositorio si pones un proxy con credenciales.

# Dirección y puerto donde se publica la interfaz (127.0.0.1 = solo este equipo).
BIND_ADDRESS=127.0.0.1
PINA_PORT=15000

# Memoria máxima del contenedor (p. ej. 3g en equipos de 4 GB, 10g para large-v3 holgado).
PINA_MEM_LIMIT=6g

# Hilos de CPU para Whisper (vacío = todos los disponibles).
PINA_CPU_THREADS=

# 1 = mantener el modelo cargado entre trabajos (más rápido); 0 = liberar RAM al terminar.
PINA_KEEP_MODEL=1

# Opcionales: solo si YouTube limita la IP del servidor.
YTDLP_PROXY=
YTDLP_COOKIES_FILE=
