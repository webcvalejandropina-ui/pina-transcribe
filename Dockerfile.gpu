# syntax=docker/dockerfile:1
# Imagen con CUDA runtime para acelerar faster-whisper en GPU NVIDIA (opcional).

FROM denoland/deno:bin-2.6.3 AS deno

FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04

LABEL org.opencontainers.image.title="pina-transcribe-gpu"
LABEL org.opencontainers.image.version="3.0.0"
LABEL org.opencontainers.image.created="2026-11-11"
LABEL org.opencontainers.image.source="https://github.com/webcvalejandropina-ui/pina-transcribe"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PINA_KEEP_MODEL=1 \
    HF_HOME=/home/app/.cache/huggingface \
    XDG_CACHE_HOME=/home/app/.cache

COPY --from=deno /deno /usr/local/bin/deno

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        ffmpeg \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --upgrade pip "setuptools>=83.0.0" \
    && pip3 install -r requirements.txt

COPY transcribe.py launcher.py web_server.py docker_entrypoint.py app_metadata.py ./
COPY utils/ utils/
COPY web/ web/

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin app \
    && mkdir -p /app/logs /app/temp /app/outputs "$HF_HOME" \
    && chown -R app:app /app /home/app

USER app

EXPOSE 15000

VOLUME ["/app/outputs", "/app/logs"]

ENTRYPOINT ["python3", "/app/docker_entrypoint.py"]
CMD []
